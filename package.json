{
	"name": "vite-plugin-butterfly-effect",
	"version": "0.1.0",
	"description": "A Vite plugin that visualizes React useEffect and state update chains as beautiful butterfly effects",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./overlay": {
			"types": "./dist/overlay.d.ts",
			"import": "./dist/overlay.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/__tests__",
		"!src/__debug__"
	],
	"scripts": {
		"build": "rm -rf dist && rolldown -c && tsc -p tsconfig.build.json --emitDeclarationOnly",
		"prepack": "npm run build",
		"lint": "biome check src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage"
	},
	"keywords": [
		"vite",
		"vite-plugin",
		"react",
		"useEffect",
		"state",
		"visualization",
		"debugging",
		"devtools"
	],
	"author": "tpryuki",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuuki-katsuta/use-butterfly-effect.git"
	},
	"homepage": "https://github.com/yuuki-katsuta/use-butterfly-effect#readme",
	"bugs": {
		"url": "https://github.com/yuuki-katsuta/use-butterfly-effect/issues"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"peerDependencies": {
		"vite": "^7.0.0 || ^8.0.0"
	},
	"dependencies": {
		"@babel/generator": "^7.26.0",
		"@babel/parser": "^7.26.0",
		"@babel/traverse": "^7.26.0",
		"@babel/types": "^7.26.0",
		"simplex-noise": "^4.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"@types/babel__generator": "^7.6.8",
		"@types/babel__traverse": "^7.20.6",
		"@types/node": "^24.10.0",
		"@vitest/coverage-v8": "^4.0.8",
		"@vitest/ui": "^4.0.8",
		"happy-dom": "^20.0.10",
		"rolldown": "^1.0.0-beta.50",
		"typescript": "^5.9.3",
		"vite": "^7.2.2",
		"vitest": "^4.0.8"
	}
}
